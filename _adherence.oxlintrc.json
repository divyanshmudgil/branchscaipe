        "selector": "JSXOpeningElement[name.name='ContextBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|from|variant|style|key|ref|className|style|children)$/]",
        "message": "<ContextBanner> doesn't accept that prop. Declared props: label, from, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextBanner'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:branch|merge)$/]",
        "message": "<ContextBanner> variant must be one of 'branch' | 'merge'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|description|children|footer|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, description, children, footer, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|side|width|title|children|glass|style|key|ref|className|style|children)$/]",
        "message": "<Drawer> doesn't accept that prop. Declared props: open, onClose, side, width, title, children, glass, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Drawer> side must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|shape|active|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, shape, active, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|soft|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'soft' | 'solid'."
