{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/branchscaipe-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Albert Sans|Orbitron))/i]",
        "message": "Font not provided by the design system. Available: Albert Sans, Orbitron."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIStatusIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|style|key|ref|className|style|children)$/]",
        "message": "<AIStatusIndicator> doesn't accept that prop. Declared props: state, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIStatusIndicator'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:thinking|typing|streaming|idle)$/]",
        "message": "<AIStatusIndicator> state must be one of 'thinking' | 'typing' | 'streaming' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssistantMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|actions|onAction|branchNew|showActions|style|key|ref|className|style|children)$/]",
        "message": "<AssistantMessage> doesn't accept that prop. Declared props: children, actions, onAction, branchNew, showActions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|kind|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:user|assistant)$/]",
        "message": "<Avatar> kind must be one of 'user' | 'assistant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|soft|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, soft, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|success|warning|error|info|new)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'success' | 'warning' | 'error' | 'info' | 'new'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchBreadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:path|onCrumb|style|key|ref|className|style|children)$/]",
        "message": "<BranchBreadcrumb> doesn't accept that prop. Declared props: path, onCrumb, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|current|label|onPrev|onNext|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<BranchIndicator> doesn't accept that prop. Declared props: count, current, label, onPrev, onNext, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchNavigator'] > JSXAttribute > JSXIdentifier[name!=/^(?:tree|activeId|onSelect|count|style|key|ref|className|style|children)$/]",
        "message": "<BranchNavigator> doesn't accept that prop. Declared props: tree, activeId, onSelect, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|fullWidth|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|glass|interactive|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, elevation, glass, interactive, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|raised|floating)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'raised' | 'floating'."
